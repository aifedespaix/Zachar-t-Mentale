# Copiez ce fichier en infra/.env — il n'est JAMAIS commité (voir .gitignore).
#
# Ces trois valeurs servent deux fois, ce qui est tout l'intérêt :
#   - le conteneur (docker-compose.yml) lit PB_ADMIN_EMAIL/PB_ADMIN_PASSWORD pour
#     créer le superutilisateur PocketBase au démarrage ;
#   - infra/setup-pocketbase.mjs lit les trois pour configurer les collections.
# Vous n'avez donc aucun export à faire à la main avant de lancer le script.

# URL du serveur. En production, celle du tunnel Cloudflare ; en local, le port
# publié du conteneur (ou un `pocketbase serve` lancé à côté).
PB_URL=https://cartes.mon-domaine.fr

# Identifiants du superutilisateur : à choisir une fois, puis à garder.
PB_ADMIN_EMAIL=admin@mon-domaine.fr
PB_ADMIN_PASSWORD=remplacez-par-un-mot-de-passe-solide
