{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Zachar’t Mentale",
  "version": "0.1.0",
  "identifier": "com.clape.zachart-mentale",
  "build": {
    "beforeDevCommand": "bun run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "bun run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Zachar’t Mentale",
        "width": 800,
        "height": 600
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDI4RUQxM0IwNTMwN0EwOEYKUldTUG9BZFRzQlB0S09leHY4bWM3S204bjF5VUp2WVdiRmlQRXlUbFNydVNkdEI1UDBrUVR6dkwK",
      "endpoints": [
        "https://github.com/aifedespaix/Zachar-t-Mentale/releases/latest/download/latest.json"
      ]
    }
  }
}
